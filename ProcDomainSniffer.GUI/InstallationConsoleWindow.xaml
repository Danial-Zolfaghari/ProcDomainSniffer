<Window x:Class="ProcDomainSniffer.GUI.InstallationConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProcDomainSniffer | Dependency installer"
        Icon="/Assets/ProcDomainSnifferIcon.png"
        Width="890" Height="570" MinWidth="630" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#090E16"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DEPENDENCY INSTALLER" FontSize="11" FontWeight="Bold" Foreground="#7E9EBB" />
                <TextBlock Text="Wireshark / TShark setup" FontSize="23" FontWeight="SemiBold" Foreground="#F0F5FC" Margin="0,5,0,0"/>
                <TextBlock Text="Live Windows Package Manager output (winget)"
                           FontSize="12" Foreground="#96A8C0" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#182C42" BorderBrush="#315276" BorderThickness="1"
                    CornerRadius="8" Padding="11,6" VerticalAlignment="Top">
                <TextBlock x:Name="InstallStateBadge" Text="RUNNING" Foreground="#8AC8FF"
                           FontWeight="SemiBold" FontSize="11"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#121B2A" BorderBrush="#25364D" BorderThickness="1"
                CornerRadius="9" Padding="12">
            <StackPanel>
                <TextBlock x:Name="StageTextBlock" Text="Preparing installation..." Foreground="#D6E7FF"
                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="The official Wireshark setup may open a separate installer dialog. Follow it to install Npcap."
                           Foreground="#9BAFC7" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,8"/>
                <ProgressBar x:Name="InstallProgressBar" Height="4" IsIndeterminate="True"
                             Background="#233247" Foreground="#6297FF"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" CornerRadius="10" BorderThickness="1" BorderBrush="#24374B"
                Background="#060B11" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="  ●  INSTALLATION CONSOLE   ·   stdout / stderr"
                           Foreground="#7FB2D5" FontSize="11" FontFamily="Consolas"
                           Margin="2,2,0,8"/>
                <TextBox x:Name="ConsoleTextBox" Background="#060B11" Foreground="#A8F0C6"
                         BorderThickness="0" FontFamily="Consolas" FontSize="12"
                         IsReadOnly="True" AcceptsReturn="True" IsTabStop="False"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ElapsedTextBlock" Grid.Column="0" Text="Elapsed: 00:00"
                       FontFamily="Consolas" FontSize="12" Foreground="#9DB2C8"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Copy log" Padding="18,8" Click="CopyLogButton_OnClick"
                    Style="{StaticResource GhostButtonStyle}"/>
            <Button x:Name="CloseInstallerButton" Grid.Column="3" Content="Close"
                    Padding="22,8" IsEnabled="False" Click="CloseInstallerButton_OnClick"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
