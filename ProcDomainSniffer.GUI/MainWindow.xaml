<Window x:Class="ProcDomainSniffer.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="ProcDomainSniffer"
        Width="1640"
        Height="960"
        MinWidth="1300"
        MinHeight="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="/Assets/ProcDomainSnifferIcon.png"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#1A2230" BorderThickness="1" Background="{StaticResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="94" />
                <RowDefinition Height="*" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0B0F15"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="28" Height="28" CornerRadius="8" Background="#111B2B" BorderBrush="#2A3E61" BorderThickness="1">
                            <Image Source="/Assets/ProcDomainSnifferIcon.png" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ProcDomainSniffer" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Process-aware domain telemetry" Style="{StaticResource TinyLabel}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border x:Name="AdminBadge"
                                Background="{StaticResource SuccessSurfaceBrush}"
                                BorderBrush="#24543A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,4"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="AdminBadgeText" Text="Administrator" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="TsharkStatusText" Text="TShark" FontSize="11" Foreground="{StaticResource MutedTextBrush}" MaxWidth="400" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="—" Style="{StaticResource WindowButtonStyle}" Click="MinimizeButton_OnClick" ToolTip="Minimize" />
                        <Button Content="□" Style="{StaticResource WindowButtonStyle}" Click="MaximizeButton_OnClick" ToolTip="Maximize / Restore" />
                        <Button Content="×" Style="{StaticResource CloseWindowButtonStyle}" Click="CloseButton_OnClick" ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,14,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.02*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.18*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.12*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.02*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.08*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentSurfaceBrush}" BorderBrush="#2F4F86" BorderThickness="1" VerticalAlignment="Center">
                            <Image Source="/Assets/ProcDomainSnifferIcon.png" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CAPTURE STATUS" Style="{StaticResource TinyLabel}" />
                            <TextBlock x:Name="StatusTextBlock" Text="Ready." FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14,11">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TARGET CAPTURE" Style="{StaticResource TinyLabel}" />
                        <TextBlock x:Name="TargetCaptureTextBlock" Text="Not selected" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="14,11">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TRACKED PROCESSES" Style="{StaticResource TinyLabel}" />
                        <TextBlock x:Name="TrackedPidsTextBlock" Text="Tracked PIDs: -" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}" Padding="14,11">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DOMAIN INTELLIGENCE" Style="{StaticResource TinyLabel}" />
                        <TextBlock x:Name="UniqueDomainsTextBlock" Text="Unique domains: 0 shown / 0 total" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="8" Style="{StaticResource CardBorderStyle}" Padding="14,11">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CAPTURE PIPELINE" Style="{StaticResource TinyLabel}" />
                        <TextBlock Text="ETW + TShark correlation" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0" Margin="16,14,16,16">
                <TabControl x:Name="WorkspaceTabs">
                    <TabItem Header="Target Application">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Choose what to monitor" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Pick a running process, or browse to an executable, then choose whether you want to track by process name or by a specific PID." Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ProcessSearchTextBox" Grid.Column="0" TextChanged="ProcessSearchTextBox_OnTextChanged" ToolTip="Filter by process name, PID or path" />
                                <Button Grid.Column="2" Content="Browse EXE" Style="{StaticResource GhostButtonStyle}" Click="BrowseExeButton_OnClick" />
                                <Button Grid.Column="4" Content="Refresh" Style="{StaticResource GhostButtonStyle}" Click="RefreshProcessesButton_OnClick" />
                            </Grid>

                            <DataGrid x:Name="ProcessesGrid" Grid.Row="4" SelectionMode="Single" MouseDoubleClick="ProcessesGrid_OnMouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PROCESS" Binding="{Binding Name}" Width="1.25*" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="90" />
                                    <DataGridTextColumn Header="PATH" Binding="{Binding Path}" Width="2.4*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1.1*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Tracking mode" Style="{StaticResource TinyLabel}" />
                                        <Grid Margin="0,10,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <RadioButton x:Name="TrackByProcessNameRadio" Grid.Column="0" Content="Process name" Style="{StaticResource SegmentRadioStyle}" IsChecked="True" Checked="TargetSelection_OnChanged" />
                                            <RadioButton x:Name="TrackByPidRadio" Grid.Column="2" Content="Exact PID" Style="{StaticResource SegmentRadioStyle}" Checked="TargetSelection_OnChanged" />
                                        </Grid>

                                        <TextBlock Text="PROCESS NAME" Style="{StaticResource TinyLabel}" Margin="0,0,0,5" />
                                        <TextBox x:Name="ProcessNameTextBox" Margin="0,0,0,10" TextChanged="TargetTextBox_OnTextChanged" />

                                        <TextBlock Text="PID" Style="{StaticResource TinyLabel}" Margin="0,0,0,5" />
                                        <TextBox x:Name="PidTextBox" Margin="0,0,0,14" TextChanged="TargetTextBox_OnTextChanged" />

                                        <WrapPanel>
                                            <Button Content="Use selected PID" Style="{StaticResource GhostButtonStyle}" Click="UseSelectedPidButton_OnClick" Margin="0,0,8,0" />
                                            <Button Content="Use process name" Style="{StaticResource GhostButtonStyle}" Click="UseSelectedNameButton_OnClick" Margin="0,0,8,0" />
                                            <Button Content="Browse EXE" Style="{StaticResource GhostButtonStyle}" Click="BrowseExeButton_OnClick" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Quick workflow" Style="{StaticResource TinyLabel}" />
                                        <TextBlock Text="How to use this panel" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        <TextBlock Text="1) Search and select your target process.&#x0a;2) Use PID or process name.&#x0a;3) Open the Capture Settings tab.&#x0a;4) Start capture and monitor the Live Events tab." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        <WrapPanel Margin="0,16,0,0">
                                            <Button Content="Open Capture Settings" Style="{StaticResource PrimaryButtonStyle}" Click="OpenCaptureSettingsTabButton_OnClick" Margin="0,0,8,8" />
                                            <Button Content="Open Live Events" Style="{StaticResource GhostButtonStyle}" Click="OpenLiveEventsTabButton_OnClick" Margin="0,0,8,8" />
                                            <Button Content="Open Domain Summary" Style="{StaticResource GhostButtonStyle}" Click="OpenDomainsTabButton_OnClick" Margin="0,0,8,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Capture Settings">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Capture configuration" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Configure ETW / TShark capture behavior, choose interfaces, and manage output." Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="1.3*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Capture behavior" Style="{StaticResource TinyLabel}" />
                                            <CheckBox x:Name="IncludeChildrenCheckBox" Content="Include child processes" IsChecked="True" Margin="0,12,0,8" />
                                            <CheckBox x:Name="ShowRepeatsCheckBox" Content="Show repeated domain events" />

                                            <TextBlock Text="EXTRA TLS PORTS" Style="{StaticResource TinyLabel}" Margin="0,18,0,5" />
                                            <TextBox x:Name="ExtraTlsPortsTextBox" ToolTip="Example: 8443,9443" Margin="0,0,0,8" />
                                            <TextBlock Text="Use this if the target app negotiates TLS on non-standard ports." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="TShark path" Style="{StaticResource TinyLabel}" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="88" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TsharkPathTextBox" Grid.Column="0" />
                                                <Button Grid.Column="2" Content="Browse" Style="{StaticResource GhostButtonStyle}" Click="BrowseTsharkButton_OnClick" />
                                            </Grid>

                                            <TextBlock Text="OUTPUT DIRECTORY" Style="{StaticResource TinyLabel}" Margin="0,16,0,5" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="88" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="OutputDirectoryTextBox" Grid.Column="0" />
                                                <Button Grid.Column="2" Content="Browse" Style="{StaticResource GhostButtonStyle}" Click="BrowseOutputDirectoryButton_OnClick" />
                                            </Grid>
                                            <Button Content="Open output folder" Style="{StaticResource GhostButtonStyle}" Click="OpenOutputFolderButton_OnClick" Margin="0,10,0,0" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="4" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Capture interfaces" Style="{StaticResource TinyLabel}" />
                                            <TextBlock Text="Select one or more interfaces, or keep “All Npcap interfaces” selected for the safest default." Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                        </StackPanel>
                                        <ListBox x:Name="InterfacesListBox" Grid.Row="2" Height="220" SelectionMode="Extended" DisplayMemberPath="Display" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="StartButton" Grid.Column="0" Content="Start capture" Style="{StaticResource PrimaryButtonStyle}" MinHeight="42" FontSize="13.5" Click="StartButton_OnClick" />
                                    <Button x:Name="StopButton" Grid.Column="2" Content="Stop" Style="{StaticResource DangerButtonStyle}" MinHeight="42" Click="StopButton_OnClick" IsEnabled="False" />
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Overview">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Capture workspace" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Use the tabs to inspect live events, review the filtered domain summary, copy data, and export the captured results." Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Quick actions" Style="{StaticResource TinyLabel}" />
                                        <TextBlock Text="Your most common workflow" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        <TextBlock Text="1) Select the target process in the Target Application tab.  2) Configure interfaces and TShark in Capture Settings.  3) Start capture.  4) Open Live Events and Domain Summary.  5) Copy or export the captured results." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        <WrapPanel Margin="0,16,0,0">
                                            <Button Content="Target Application" Style="{StaticResource GhostButtonStyle}" Click="OpenTargetTabButton_OnClick" Margin="0,0,8,8" />
                                            <Button Content="Capture Settings" Style="{StaticResource GhostButtonStyle}" Click="OpenCaptureSettingsTabButton_OnClick" Margin="0,0,8,8" />
                                            <Button Content="Open Live Events" Style="{StaticResource GhostButtonStyle}" Click="OpenLiveEventsTabButton_OnClick" Margin="0,0,8,8" />
                                            <Button Content="Open Domain Summary" Style="{StaticResource GhostButtonStyle}" Click="OpenDomainsTabButton_OnClick" Margin="0,0,8,8" />
                                            <Button Content="Domain + IP" Style="{StaticResource GhostButtonStyle}" Click="OpenDomainIpTabButton_OnClick" Margin="0,0,8,8" />
                                            <Button Content="Network Log" Style="{StaticResource GhostButtonStyle}" Click="OpenNetworkTabButton_OnClick" Margin="0,0,8,8" />
                                            <Button Content="Export domains" Style="{StaticResource PrimaryButtonStyle}" Click="ExportDomainsButton_OnClick" Margin="0,0,8,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Summary filters" Style="{StaticResource TinyLabel}" />
                                        <TextBlock Text="Fine-tune what you see" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        <CheckBox x:Name="HideLocalhostInSummaryCheckBox" Content="Hide localhost / loopback / internal hosts in Domain Summary" IsChecked="True" Checked="FilterOptions_OnChanged" Unchecked="FilterOptions_OnChanged" Margin="0,12,0,8" />
                                        <CheckBox x:Name="ShowLocalhostInLiveCheckBox" Content="Show localhost / loopback events in Live Events" IsChecked="False" Checked="FilterOptions_OnChanged" Unchecked="FilterOptions_OnChanged" Margin="0,0,0,8" />
                                        <TextBlock Text="These filters only affect what is shown in the GUI and exported from each tab. Raw capture files are still saved in the output folder." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Live Events">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="18,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Live domain events" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="DNS, TLS SNI and HTTP host observations attributed to the selected process." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBox x:Name="LiveSearchTextBox" Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center" ToolTip="Search live events" TextChanged="LiveSearchTextBox_OnTextChanged" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="LiveShowLocalhostCheckBoxMirror" Content="Show localhost" IsChecked="False" Checked="LiveShowLocalhostCheckBoxMirror_OnChanged" Unchecked="LiveShowLocalhostCheckBoxMirror_OnChanged" Margin="0,0,10,0" />
                                        <Button Content="Copy" Style="{StaticResource GhostButtonStyle}" Click="CopyLiveEventsButton_OnClick" Margin="0,0,8,0" />
                                        <Button Content="Copy All" Style="{StaticResource GhostButtonStyle}" Click="CopyAllLiveEventsButton_OnClick" Margin="0,0,8,0" />
                                        <Button Content="Export" Style="{StaticResource GhostButtonStyle}" Click="ExportLiveEventsButton_OnClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataGrid x:Name="EventsGrid" PreviewKeyDown="DataGrid_OnPreviewKeyDown" MouseDoubleClick="DataGrid_OnMouseDoubleClick" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Margin="16,14,16,16">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="108" />
                                    <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="104" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                                    <DataGridTextColumn Header="DOMAIN" Binding="{Binding Domain}" Width="2.5*" />
                                    <DataGridTextColumn Header="PROTO" Binding="{Binding Protocol}" Width="72" />
                                    <DataGridTextColumn Header="LOCAL ENDPOINT" Binding="{Binding Local}" Width="1.45*" />
                                    <DataGridTextColumn Header="REMOTE ENDPOINT" Binding="{Binding Remote}" Width="1.45*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Domain Summary">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="18,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Domain summary" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Unique hosts and aggregated counts. Localhost-like entries can be hidden here." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBox x:Name="DomainsSearchTextBox" Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center" ToolTip="Search domains" TextChanged="DomainsSearchTextBox_OnTextChanged" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="DomainsHideLocalhostCheckBoxMirror" Content="Hide localhost" IsChecked="True" Checked="DomainsHideLocalhostCheckBoxMirror_OnChanged" Unchecked="DomainsHideLocalhostCheckBoxMirror_OnChanged" Margin="0,0,10,0" />
                                        <Button Content="Copy" Style="{StaticResource GhostButtonStyle}" Click="CopyDomainsButton_OnClick" Margin="0,0,8,0" />
                                        <Button Content="Copy All" Style="{StaticResource GhostButtonStyle}" Click="CopyAllDomainsButton_OnClick" Margin="0,0,8,0" />
                                        <Button Content="Export" Style="{StaticResource GhostButtonStyle}" Click="ExportDomainsButton_OnClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataGrid x:Name="DomainsGrid" PreviewKeyDown="DataGrid_OnPreviewKeyDown" MouseDoubleClick="DataGrid_OnMouseDoubleClick" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Margin="16,14,16,16">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DOMAIN" Binding="{Binding Domain}" Width="2.2*" />
                                    <DataGridTextColumn Header="COUNT" Binding="{Binding Count}" Width="74" />
                                    <DataGridTextColumn Header="SOURCES" Binding="{Binding Sources}" Width="1.3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Domain + IP">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="18,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Domain + IP / filter status" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Observed domains with resolved public IPs. Private, loopback, link-local and other non-public addresses are excluded. Missing DNS answers are retried through the Windows resolver." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBox x:Name="DomainIpSearchTextBox" Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center" ToolTip="Search domain, IP, status, or source" TextChanged="DomainIpSearchTextBox_OnTextChanged" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Copy" Style="{StaticResource GhostButtonStyle}" Click="CopyDomainIpsButton_OnClick" Margin="0,0,8,0" />
                                        <Button Content="Copy All" Style="{StaticResource GhostButtonStyle}" Click="CopyAllDomainIpsButton_OnClick" Margin="0,0,8,0" />
                                        <Button Content="Export" Style="{StaticResource GhostButtonStyle}" Click="ExportDomainIpsButton_OnClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataGrid x:Name="DomainIpsGrid" PreviewKeyDown="DataGrid_OnPreviewKeyDown" MouseDoubleClick="DataGrid_OnMouseDoubleClick" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Margin="16,14,16,16">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DOMAIN" Binding="{Binding Domain}" Width="2.0*" />
                                    <DataGridTextColumn Header="RESOLVED IP(S)" Binding="{Binding ResolvedIps}" Width="2.35*" />
                                    <DataGridTextColumn Header="IP COUNT" Binding="{Binding IpCount}" Width="90" />
                                    <DataGridTemplateColumn Header="STATUS" Width="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="RESOLVED">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="UNRESOLVED">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="SOURCES" Binding="{Binding Sources}" Width="1.25*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Network Log">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="18,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Process network log" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="TCP / UDP packets attributed to the selected process. Domain is inferred when available; packets without a known domain remain visible with —." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBox x:Name="NetworkSearchTextBox" Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center" ToolTip="Search IP, port, protocol, domain, or time" TextChanged="NetworkSearchTextBox_OnTextChanged" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="HideLoopbackNetworkCheckBox" Content="Hide loopback" IsChecked="True" Checked="NetworkOptions_OnChanged" Unchecked="NetworkOptions_OnChanged" Margin="0,0,10,0" ToolTip="Hide localhost, 127.0.0.1 and ::1 traffic" />
                                        <CheckBox x:Name="HideInternalNetworkCheckBox" Content="Hide private IPs" IsChecked="False" Checked="NetworkOptions_OnChanged" Unchecked="NetworkOptions_OnChanged" Margin="0,0,10,0" ToolTip="Hide remote/internal RFC1918, link-local and CGNAT destinations such as 192.168.x.x, 10.x.x.x and 172.16-31.x.x" />
                                        <CheckBox x:Name="UniqueNetworkCheckBox" Content="Unique only" IsChecked="False" Checked="NetworkOptions_OnChanged" Unchecked="NetworkOptions_OnChanged" Margin="0,0,10,0" ToolTip="Ignore time when de-duplicating; repeated rows only update their latest time and request count" />
                                        <CheckBox x:Name="IgnoreSourceIpNetworkCheckBox" Content="Ignore source IP" IsChecked="False" Checked="NetworkOptions_OnChanged" Unchecked="NetworkOptions_OnChanged" Margin="0,0,10,0" ToolTip="Hide Source IP and, in Unique mode, collapse incoming/outgoing packets into one row using the normalized remote endpoint" />
                                        <CheckBox x:Name="IgnoreDestinationPortNetworkCheckBox" Content="Ignore dest port" IsChecked="False" Checked="NetworkOptions_OnChanged" Unchecked="NetworkOptions_OnChanged" Margin="0,0,10,0" ToolTip="Hide destination port and exclude it from the Unique key, collapsing different ports for the same endpoint/protocol/domain" />
                                        <Button Content="Copy" Style="{StaticResource GhostButtonStyle}" Click="CopyNetworkButton_OnClick" Margin="0,0,8,0" />
                                        <Button Content="Copy All" Style="{StaticResource GhostButtonStyle}" Click="CopyAllNetworkButton_OnClick" Margin="0,0,8,0" />
                                        <Button Content="Export" Style="{StaticResource GhostButtonStyle}" Click="ExportNetworkButton_OnClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataGrid x:Name="NetworkGrid" PreviewKeyDown="DataGrid_OnPreviewKeyDown" MouseDoubleClick="DataGrid_OnMouseDoubleClick" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Margin="16,14,16,16">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="92" />
                                    <DataGridTextColumn x:Name="NetworkSourceIpColumn" Header="SOURCE IP" Binding="{Binding SourceIp}" Width="1.25*" />
                                    <DataGridTextColumn Header="DESTINATION IP" Binding="{Binding DestinationIp}" Width="1.25*" />
                                    <DataGridTextColumn x:Name="NetworkDestinationPortColumn" Header="DEST PORT" Binding="{Binding DestinationPort}" Width="90" />
                                    <DataGridTextColumn Header="PROTOCOL" Binding="{Binding Protocol}" Width="86" />
                                    <DataGridTextColumn Header="REQUESTS" Binding="{Binding Requests}" Width="92" />
                                    <DataGridTextColumn Header="DOMAIN" Binding="{Binding Domain}" Width="2.2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Activity Log">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="18,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Activity log" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Collector state, warnings and ETW / TShark messages." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBox x:Name="LogSearchTextBox" Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center" ToolTip="Search activity log" TextChanged="LogSearchTextBox_OnTextChanged" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Copy" Style="{StaticResource GhostButtonStyle}" Click="CopyLogsButton_OnClick" Margin="0,0,8,0" />
                                        <Button Content="Copy All" Style="{StaticResource GhostButtonStyle}" Click="CopyAllLogsButton_OnClick" Margin="0,0,8,0" />
                                        <Button Content="Export" Style="{StaticResource GhostButtonStyle}" Click="ExportLogsButton_OnClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataGrid x:Name="LogGrid" PreviewKeyDown="DataGrid_OnPreviewKeyDown" MouseDoubleClick="DataGrid_OnMouseDoubleClick" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Margin="16,14,16,16">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="86" />
                                    <DataGridTextColumn Header="LEVEL" Binding="{Binding Level}" Width="76" />
                                    <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Row="3" Background="#0B0F15" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessTextBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="Output" Style="{StaticResource TinyLabel}" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="OutputFolderStatusTextBlock"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                </Grid>
            </Border>

            <Border x:Name="ToastBorder"
                    Grid.Row="0"
                    Grid.RowSpan="4"
                    Panel.ZIndex="999"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,58"
                    Background="#E5172232"
                    BorderBrush="#4E6F9F"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,9"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessTextBrush}" Margin="0,0,9,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ToastTextBlock" Text="Copied" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
